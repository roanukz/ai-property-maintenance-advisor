# Copy to .env in the repo root and fill in the values. .env is gitignored:
# never commit it, and never paste a key anywhere else. Only live commands
# read it (advisor ask/resume --live, advisor check-schema --live, advisor
# eval --live); replay never does. A variable already set in the environment
# always wins over this file.

# Anthropic, for every live model call.
ANTHROPIC_API_KEY=

# Tavily, for live search and fetch (ask and resume; check-schema does not need it).
TAVILY_API_KEY=

# TypeSafe, for Jev's safety step check (ask and resume while
# config.JEV_SAFETY_ENABLED is True; check-schema never reads it).
TYPESAFE_API_KEY=

# LangSmith, read only when ADVISOR_TRACING=1 is set in the environment.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=
